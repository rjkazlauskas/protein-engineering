@article{bermudez-garciaANCUT2ThermoalkalineCutinase2017,
  title = {{{ANCUT2}}, a {{Thermo-alkaline}} Cutinase from {{Aspergillus}} Nidulans Enzymes for Biodegradation of Poly(Ethylene Terephthalate)},
  author = {{Bermúdez-García}, Eva and {Peña-Montes}, Carolina and {Castro-Rodríguez}, José Augusto and {González-Canto}, Augusto and {Navarro-Ocaña}, Arturo and Farrés, Amelia},
  year = 2017,
  month = jul,
  journal = {Appl. Biochem. Biotechnol.},
  volume = {182},
  number = {3},
  pages = {1014--1036},
  doi = {10.1007/s12010-016-2378-z},
  abstract = {© 2017, Springer Science+Business Media New York. Biochemical characterization of purified ANCUT2 cutinase from Aspergillus nidulans is described. The identified amino acid sequence differs from that predicted in Aspergillus genomic databases in amino acids not relevant for catalysis. The enzyme is thermo-alkaline, showing its maximum activity at pH 9 and 60 °C, and it retains more than 60\% of its initial activity after incubation for 1 h at 60 °C for pH values between 6 and 10. ANCUT2 is more active towards long-chain esters and it hydrolyzes cutin; however, it also hydrolyzes short-chain esters. Cutinase is inhibited by metal ions, PMSF, SDS, and EDTA (10 mM). It retains 50\% of its activity in most of the solvents tested, although it is more stable in hydrophobic solvents. According to its found biochemical properties, preliminary assays demonstrate its ability to synthesize methyl esters from sesame oil and the most likely application of this enzyme remains in detergent formulations.},
  langid = {english},
  pmid = {28124733},
  file = {/Users/romas/Zotero/storage/YJP7S59A/Bermúdez-García et al. - 2017 - ANCUT2, a Thermo-alkaline cutinase from Aspergillu.pdf}
}


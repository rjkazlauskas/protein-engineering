@article{kellettComputationalStructuralKinetic2013,
  title = {Computational, Structural, and Kinetic Evidence That \textbackslash{{emphVibrio}} Vulnificus {{FrsA}} Is Not a Cofactor-Independent Pyruvate Decarboxylase.},
  author = {Kellett, Whitney F and Brunk, Elizabeth and Desai, Bijoy J and Fedorov, Alexander A and Almo, Steven C and Gerlt, John A and Rothlisberger, Ursula and Richards, Nigel G J},

@article{liscovitch-brauerTradeoffTranscriptomePlasticity2017,
  title = {Trade-off between Transcriptome Plasticity and Genome Evolution in Cephalopods.},
  author = {{Liscovitch-Brauer}, Noa and Alon, Shahar and Porath, Hagit T and Elstein, Boaz and Unger, Ron and Ziv, Tamar and Admon, Arie and Levanon, Erez Y and Rosenthal, Joshua J C and Eisenberg, Eli},
  year = 2017,
  month = apr,
  journal = {Cell},
  volume = {169},
  number = {2},
  pages = {191--202.e11},
  doi = {10.1016/j.cell.2017.03.025},
  abstract = {RNA editing, a post-transcriptional process, allows the diversification of proteomes beyond the genomic blueprint; however it is infrequently used among animals for this purpose. Recent reports suggesting increased levels of RNA editing in squids thus raise the question of the nature and effects of these events. We here show that RNA editing is particularly common in behaviorally sophisticated coleoid cephalopods, with tens of thousands of evolutionarily conserved sites. Editing is enriched in the nervous system, affecting molecules pertinent for excitability and neuronal morphology. The genomic sequence flanking editing sites is highly conserved, suggesting that the process confers a selective advantage. Due to the large number of sites, the surrounding conservation greatly reduces the number of mutations and genomic polymorphisms in protein-coding regions. This trade-off between genome evolution and transcriptome plasticity highlights the importance of RNA recoding as a strategy for diversifying proteins, particularly those associated with neural function. PAPERCLIP.},
  langid = {english},
  pmid = {28388405},
  file = {/Users/romas/Zotero/storage/KCXBC6PI/823A3FF3-01D2-4B39-8D89-248738C2B597.pdf}
}


@article{chenSynthesisDNACleavage1998,
  title = {Synthesis, {{DNA}} Cleavage and Cytotoxicity of Some Novel Cyclic Peptide-2,6-Dimethoxyhydroquinone-3-Mercaptoacetic Acid Conjugates Containing {{D-amino}} Acids.},
  author = {Chen, Sen-Liang and Wong, Ricky Ngok Shin and Lo, Vivian and Chang, Suzi and Chiang, Chi-Der and Sheh, Leung},
  year = 1998,

@article{guterlUnevenTwinsComparison2009,
  title = {Uneven Twins: Comparison of Two Enantiocomplementary Hydroxynitrile Lyases with Alpha/Beta-Hydrolase Fold.},
  author = {Guterl, Jan-Karl and Andexer, Jennifer N and Sehl, Torsten and {von Langermann}, Jan and {Frindi-Wosch}, Ilona and Rosenkranz, Tobias and Fitter, Jörg and Gruber, Karl and Kragl, Udo and Eggert, Thorsten and Pohl, Martina},
  year = 2009,
  month = may,
  journal = {J. Biotechnol.},

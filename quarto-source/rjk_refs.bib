@article{ajikumarIsoprenoidPathwayOptimization2010,
  title = {Isoprenoid Pathway Optimization for {{Taxol}} Precursor Overproduction in {{Escherichia}} Coli.},
  author = {Ajikumar, Parayil Kumaran and Xiao, Wen-Hai and Tyo, Keith E J and Wang, Yong and Simeon, Fritz and Leonard, Effendi and Mucha, Oliver and Phon, Too Heng and Pfeifer, Blaine and Stephanopoulos, Gregory},
  year = 2010,

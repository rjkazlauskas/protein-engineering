@article{st-pierreTerminalOacetyltransferaseInvolved1998,
  title = {The Terminal {{O-acetyltransferase}} Involved in Vindoline Biosynthesis Defines a New Class of Proteins Responsible for Coenzyme {{A-dependent}} Acyl Transfer.},

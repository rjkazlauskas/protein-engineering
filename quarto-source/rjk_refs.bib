@article{liComputationalRedesignEnzymes2018,
  title = {Computational Redesign of Enzymes for Regio- and Enantioselective Hydroamination},
  author = {Li, Ruifeng and Wijma, Hein J and Song, Lu and Cui, Yinglu and Otzen, Marleen and Tian, Yu’e and Du, Jiawei and Li, Tao and Niu, Dingding and Chen, Yanchun and Feng, Jing and Han, Jian and Chen, Hao and Tao, Yong and Janssen, Dick B and Wu, Bian},
  year = 2018,

@article{beckieHerbicideresistantWeedManagement2011,
  title = {Herbicide-Resistant Weed Management: Focus on Glyphosate.},
  author = {Beckie, Hugh J},
  year = 2011,
  month = sep,
  journal = {Pest Manag. Sci.},
  volume = {67},
  number = {9},
  pages = {1037--1048},
  doi = {10.1002/ps.2195},
  abstract = {This review focuses on proactive and reactive management of glyphosate-resistant (GR) weeds. Glyphosate resistance in weeds has evolved under recurrent glyphosate usage, with little or no diversity in weed management practices. The main herbicide strategy for proactively or reactively managing GR weeds is to supplement glyphosate with herbicides of alternative modes of action and with soil-residual activity. These herbicides can be applied in sequences or mixtures. Proactive or reactive GR weed management can be aided by crop cultivars with alternative single or stacked herbicide-resistance traits, which will become increasingly available to growers in the future. Many growers with GR weeds continue to use glyphosate because of its economical broad-spectrum weed control. Government farm policies, pesticide regulatory policies and industry actions should encourage growers to adopt a more proactive approach to GR weed management by providing the best information and training on management practices, information on the benefits of proactive management and voluntary incentives, as appropriate. Results from recent surveys in the United States indicate that such a change in grower attitudes may be occurring because of enhanced awareness of the benefits of proactive management and the relative cost of the reactive management of GR weeds.},
  langid = {english},
  pmid = {21548004},
  file = {/Users/romas/Zotero/storage/M3ETW5HW/822B9237-D6FA-4BD3-AEDE-939D4CD6DCED.pdf}
}


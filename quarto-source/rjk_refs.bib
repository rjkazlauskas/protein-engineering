@article{olsenFunctionbasedIsolationNovel2000,
  title = {Function-Based Isolation of Novel Enzymes from a Large Library.},
  author = {Olsen, Mark J and Stephens, Daren and Griffiths, Devin and Daugherty, Patrick S and Georgiou, George and Iverson, Brent L},
  year = 2000,
  month = oct,
  journal = {Nat. Biotechnol.},
  volume = {18},
  number = {10},
  pages = {1071--1074},
  doi = {10.1038/80267},
  abstract = {Here we describe a high-throughput, quantitative method for the isolation of enzymes with novel substrate specificities from large libraries of protein variants. Protein variants are displayed on the surface of microorganisms and incubated with a synthetic substrate consisting of (1) a fluorescent dye (2) a positively charged moiety (3) the target scissile bond, and (4) a fluorescence resonance energy transfer (FRET) quenching partner. Enzymatic cleavage of the scissile bond results in release of the FRET quenching partner while the fluorescent product is retained on the cell surface, allowing isolation of catalytically active clones by fluorescence-activated cell sorting (FACS). Using a synthetic substrate with these characteristics, we enriched Escherichia coli expressing the serine protease OmpT from cells expressing an inactive OmpT variant by over 5,000-fold in a single round. Screening a library of 6 x 10(5) random OmpT variants by FACS using a FRET peptide substrate with a nonpreferred Arg-Val cleavage sequence resulted in the isolation of variant proteases with catalytic activities enhanced by as much as 60-fold. This approach represents a potentially widely applicable method for high-throughput screening of large libraries on the basis of catalytic turnover.},
  langid = {english},
  pmid = {11017045},
  file = {/Users/romas/Zotero/storage/CS2XGK5K/Olsen et al. - 2000 - Function-based isolation of novel enzymes from a l.pdf}
}


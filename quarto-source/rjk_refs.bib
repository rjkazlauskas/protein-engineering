@article{garcia-ruizEvolvingThermostabilityMutant2010,
  title = {Evolving Thermostability in Mutant Libraries of Ligninolytic Oxidoreductases Expressed in Yeast},
  author = {{García-Ruiz}, Eva and Maté, Diana and Ballesteros, Antonio O and Martínez, Angel T and Alcalde, Miguel},

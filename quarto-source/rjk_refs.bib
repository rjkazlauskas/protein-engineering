  year = 2013,
  month = sep,
  journal = {Structure},
  volume = {21},
  number = {9},
  pages = {1690--1697},
  doi = {10.1016/j.str.2013.06.020},
  abstract = {Little is known about the evolution of protein structures and the degree of protein structure conservation over planetary time scales. Here, we report the X-ray crystal structures of seven laboratory resurrections of Precambrian thioredoxins dating up to approximately four billion years ago. Despite considerable sequence differences compared with extant enzymes, the ancestral proteins display the canonical thioredoxin fold, whereas only small structural changes have occurred over four billion years. This remarkable degree of structure conservation since a time near the last common ancestor of life supports a punctuated-equilibrium model of structure evolution in which the generation of new folds occurs over comparatively short periods and is followed by long periods of structural stasis.},
  langid = {english},
  pmcid = {PMC3774310},

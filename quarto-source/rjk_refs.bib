@article{youVitroSyntheticBiology2017,
  title = {An in Vitro Synthetic Biology Platform for the Industrial Biomanufacturing of Myo‐inositol from Starch},
  author = {You, Chun and Shi, Ting and Li, Yunjie and Han, Pingping and Zhou, Xigui and Zhang, Yi‐Heng Percival},
  year = 2017,

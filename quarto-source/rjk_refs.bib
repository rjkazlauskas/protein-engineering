@article{liResolution2nitroalcoholsBurkholderia2012,
  title = {Resolution of 2-Nitroalcohols by {{Burkholderia}} Cepacia Lipase-Catalyzed Enantioselective Acylation},
  author = {Li, Na and Hu, Shi-Bin and Feng, Gui-Ying},
  year = 2012,
  month = jan,
  journal = {Biotechnol Lett},
  volume = {34},
  number = {1},
  pages = {153--158},
  issn = {0141-5492, 1573-6776},
  doi = {10.1007/s10529-011-0754-x},
  urldate = {2020-03-29},

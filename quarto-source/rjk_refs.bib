@article{bommariusProteinEngineeringCellulases2014,
  title = {Protein Engineering of Cellulases},
  author = {Bommarius, Andreas S and Sohn, Minjeong and Kang, Yuzhi and Lee, Jay H and Realff, Matthew J},

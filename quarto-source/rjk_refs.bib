@article{arvayEngineeringAcinetobacterBaylyi2021,
  title = {Engineering {{{\emph{Acinetobacter baylyi}}}} {{ADP1}} for Mevalonate Production from Lignin-Derived Aromatic Compounds},
  author = {Arvay, Erika and Biggs, Bradley W. and Guerrero, Laura and Jiang, Virginia and Tyo, Keith},
  year = 2021,

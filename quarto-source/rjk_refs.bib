@article{baiImprovedThermostabilityCreatinase2020,
  title = {Improved Thermostability of Creatinase from {{Alcaligenes}} Faecalis through Non-Biased Phylogenetic Consensus-Guided Mutagenesis},
  author = {Bai, Xue and Li, Daixi and Ma, Fuqiang and Deng, Xi and Luo, Manjie and Feng, Yan and Yang, Guangyu},
  year = 2020,
  month = dec,
  journal = {Microb Cell Fact},

@article{tanakaAnalysisIonicInteraction2017,
  title = {Analysis of the Ionic Interaction between the Hydrophobin {{RodA}} and Two Cutinases of {{Aspergillus}} Nidulans Obtained via an {{Aspergillus}} Oryzae Expression System},
  author = {Tanaka, Takumi and Nakayama, Mayumi and Takahashi, Toru and Nanatani, Kei and Yamagata, Youhei and Abe, Keietsu},
  year = 2017,
  month = mar,

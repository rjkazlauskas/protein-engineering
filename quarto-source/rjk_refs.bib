@article{foxCatalyticEffectivenessMeasure2009,
  title = {Catalytic Effectiveness, a Measure of Enzyme Proficiency for Industrial Applications},
  author = {Fox, Richard J and Clay, Michael D},
  year = 2009,
  month = mar,
  journal = {Trends Biotechnol.},

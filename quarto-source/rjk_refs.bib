@article{nguyenCosolventPretreatmentReduces2015,
  title = {Co-Solvent Pretreatment Reduces Costly Enzyme Requirements for High Sugar and Ethanol Yields from Lignocellulosic Biomass.},
  author = {Nguyen, Thanh Yen and Cai, Charles M and Kumar, Rajeev and Wyman, Charles E},

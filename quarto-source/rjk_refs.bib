@article{xiSecretoryExpressionBacillus2021,
  title = {Secretory Expression in {{{\emph{Bacillus}}}}{\emph{ Subtilis}} and Biochemical Characterization of a Highly Thermostable Polyethylene Terephthalate Hydrolase from Bacterium {{HR29}}},
  author = {Xi, Xingxiang and Ni, Kefeng and Hao, Helong and Shang, Yuepeng and Zhao, Bo and Qian, Zhen},

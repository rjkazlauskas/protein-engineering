@article{baathComparativeBiochemistryFour2021,
  title = {Comparative Biochemistry of Four Polyester ({{PET}}) Hydrolases},
  author = {Bååth, Jenny Arnling and Borch, Kim and Jensen, Kenneth and Brask, Jesper and Westh, Peter},
  year = 2021,
  month = may,
  journal = {ChemBioChem},
  volume = {22},

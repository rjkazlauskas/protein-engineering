@incollection{shin55YearsRossmann2019,
  title = {55 {{Years}} of the {{Rossmann Fold}}},
  booktitle = {Protein {{Supersecondary Structures}}},
  author = {Shin, Woong-Hee and Kihara, Daisuke},
  editor = {Kister, Alexander E.},
  year = 2019,
  volume = {1958},
  pages = {1--13},
  publisher = {Springer New York},
  address = {New York, NY},
  doi = {10.1007/978-1-4939-9161-7_1},
  urldate = {2021-06-14},
  abstract = {The Rossmann fold is one of the most commonly observed structural domains in proteins. The fold is composed of consecutive alternating β-strands and α-helices that form a layer of β-sheet with one (or two) layer(s) of α-helices. Here, we will discuss the Rossmann fold starting from its discovery 55 years ago, then overview entries of the fold in the major protein classification databases, SCOP and CATH, as well as the number of the occurrences of the fold in genomes. We also discuss the Rossmann fold as an interesting target of protein engineering as the site-directed mutagenesis of the fold can alter the ligand-binding specificity of the structure.},

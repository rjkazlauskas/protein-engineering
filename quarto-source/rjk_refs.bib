@article{maySubstratedependentEnantioselectivityNovel1998,
  title = {Substrate-Dependent Enantioselectivity of a Novel Hydantoinase from {{Arthrobacter}} Aurescens {{DSM}} 3745: Purification and Characterization as New Member of Cyclic Amidases.},
  author = {May, Oliver and Siemann, M and Pietzsch, Markus and Kiess, M and Mattes, R and Syldatk, Christoph},
  year = 1998,
  month = mar,
  journal = {J. Biotechnol.},

@article{shortlePropensitiesProbabilitiesBoltzmann2003,
  title = {Propensities, Probabilities, and the {{Boltzmann}} Hypothesis},
  author = {Shortle, David},
  year = 2003,
  month = jun,
  journal = {Protein Sci.},
  volume = {12},
  number = {6},
  pages = {1298--1302},
  issn = {09618368, 1469896X},
  doi = {10.1110/ps.0306903},
  urldate = {2020-01-22},
  abstract = {The relative strengths of interactions involving polypeptide chains can be estimated with reasonable accuracy with statistical potentials, free-energy functions derived from the frequency of occurrence of structural arrangements of residues or atoms in collections of protein structures. Recent published work has shown that the energetics of side-chain/backbone interactions can be modeled by the ␾/␺ propensities of the 20 amino acids. In this report, the more commonly used ␾/␺ probabilities are demonstrated to fail in evaluating the free energies of protein conformations because of an overriding preference for all helical structures. Comparison of the hypothetical reactions implied by these two different statistics—propensities versus probabilities—leads to the conclusion that the Boltzmann hypothesis may only be applicable for the calculation of statistical potentials after the starting conformation has been specified. This conclusion supports a simple conjecture: The surprising success of the Boltzmann hypothesis in explaining the energetics of protein structures is a direct consequence of a real equilibrium, one extending over evolutionary time that has maintained the stability of each protein within a narrow range of values.},
  langid = {english},
  file = {/Users/romas/Zotero/storage/PRXV7X58/Shortle - 2003 - Propensities, probabilities, and the Boltzmann hyp.pdf}
}


@article{broccaSequenceLidAffects2003,
  title = {Sequence of the Lid Affects Activity and Specificity of {{Candida}} Rugosa Lipase Isoenzymes.},
  author = {Brocca, Stefania and Secundo, Francesco and Ossola, Mattia and Alberghina, Lilia and Carrea, Giacomo and Lotti, Marina},

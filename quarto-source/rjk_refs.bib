@article{alkemaCharacterizationBetalactamBinding2000,
  title = {Characterization of the Beta-Lactam Binding Site of Penicillin Acylase of {{Escherichia}} Coli by Structural and Site-Directed Mutagenesis Studies.},
  author = {Alkema, Wynand B L and Hensgens, C M and Kroezinga, E H and {de Vries}, Erik and Floris, René and {van der Laan}, Jan-Metske and Dijkstra, Bauke W and Janssen, Dick B},

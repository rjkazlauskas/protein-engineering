@article{singhChemistrySnitrosoglutathioneGlutathione1996,
  title = {The Chemistry of the {{S-nitrosoglutathione}} Glutathione System},
  author = {Singh, S P and Wishnok, John S and Keshive, M and Deen, {\relax WM} and Tannenbaum, {\relax SR}},
  year = 1996,

@article{kamiya2hydroxydATPIncorporatedOpposite2000,
  title = {2-Hydroxy-{{dATP}} Is Incorporated Opposite {{G}} by {{Escherichia}} Coli {{DNA}} Polymerase {{III}} Resulting in High Mutagenicity},

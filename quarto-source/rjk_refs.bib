@article{gadeSubstrateDynamicsContribute2021,
  title = {Substrate Dynamics Contribute to Enzymatic Specificity in Human and Bacterial Methionine Adenosyltransferases},
  author = {Gade, Madhuri and Tan, Li Lynn and Damry, Adam M. and Sandhu, Mahakaran and Brock, Joseph S. and Delaney, Andie and {Villar-Briones}, Alejandro and Jackson, Colin J. and Laurino, Paola},

  author = {Musil, Milos and Stourac, Jan and Bendl, Jaroslav and Brezovsky, Jan and Prokop, Zbynek and Zendulka, Jaroslav and Martinek, Tomas and Bednar, David and Damborsky, Jirí},
  year = 2017,

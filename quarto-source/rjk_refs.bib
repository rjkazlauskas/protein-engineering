@article{zhangPurificationHightemperatureResistant2022,
  title = {Purification of High-Temperature Resistant Polyethylene Terephthalate ({{PET}}) Hydrolase by Simple Heating Protocol},
  author = {Zhang, Zixuan and Cai, Di and Shao, Chaofeng and Chen, Changjing and Chen, Biqiang},

@article{bapatQuantificationMetabolicallyActive2006,
  title = {Quantification of Metabolically Active Biomass Using {{Methylene Blue}} Dye {{Reduction Test}} ({{MBRT}}): Measurement of {{CFU}} in about 200 s.},
  author = {Bapat, Prashant and Nandy, Subir Kumar and Wangikar, Pramod P and Venkatesh, K V},
  year = 2006,

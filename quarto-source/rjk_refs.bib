  pages = {442--446},
  doi = {10.1038/87610},
  abstract = {The crystal structure of a pepstatin-insensitive carboxyl proteinase from Pseudomonas sp. 101 (PSCP) has been solved by single-wavelength anomalous diffraction using the absorption peak of bromide anions. Structures of the uninhibited enzyme and of complexes with an inhibitor that was either covalently or noncovalently bound were refined at 1.0-1.4 A resolution. The structure of PSCP comprises a single compact domain with a diameter of approximately 55 A, consisting of a seven-stranded parallel beta-sheet flanked on both sides by a number of helices. The fold of PSCP is a superset of the subtilisin fold, and the covalently bound inhibitor is linked to the enzyme through a serine residue. Thus, the structure of PSCP defines a novel family of serine-carboxyl proteinases (defined as MEROPS S53) with a unique catalytic triad consisting of Glu 80, Asp 84 and Ser 287.},

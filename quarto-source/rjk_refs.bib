@article{fierkeConstructionEvaluationKinetic1987,
  title = {Construction and Evaluation of the Kinetic Scheme Associated with Dihydrofolate Reductase from {{{\emph{Escherichia coli}}}}},
  author = {Fierke, Carol A. and Johnson, Kenneth A. and Benkovic, Stephen J.},

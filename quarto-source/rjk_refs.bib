@article{jonesComparisonFiveProtein2017,
  title = {Comparison of Five Protein Engineering Strategies for Stabilizing an α/β-Hydrolase},
  author = {Jones, Bryan J and Lim, Huey Yee and Huang, Jun and Kazlauskas, Romas J},
  year = 2017,
  month = dec,
  journal = {Biochemistry},

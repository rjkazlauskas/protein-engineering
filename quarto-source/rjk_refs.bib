@article{schoefflerExtremeFreeEnergy2004,
  title = {Extreme Free Energy of Stabilization of {{Taq DNA}} Polymerase},
  author = {Schoeffler, Allyn J. and Joubert, Allison M. and Peng, Fenggang and Khan, Farheen and Liu, Chin-Chi and LiCata, Vince J.},

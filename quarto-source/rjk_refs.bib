@article{ottossonSizeParameterSolvent2002,
  title = {Size as a Parameter for Solvent Effects on {{Candida}} Antarctica Lipase {{B}} Enantioselectivity.},
  author = {Ottosson, Jenny and Fransson, Linda and King, Jerry W and Hult, Karl},

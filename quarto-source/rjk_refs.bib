@article{gudiksenEliminatingPositivelyCharged2005,
  title = {Eliminating Positively Charged Lysine Epsilon-{{NH3}}+ Groups on the Surface of Carbonic Anhydrase Has No Significant Influence on Its Folding from Sodium Dodecyl Sulfate.},
  author = {Gudiksen, Katherine L and Gitlin, Irina and Yang, Jerry and Urbach, Adam R and Moustakas, Demetri T and Whitesides, George M},
  year = 2005,
  month = apr,
  journal = {J. Am. Chem. Soc.},
  volume = {127},
  number = {13},
  pages = {4707--4714},
  doi = {10.1021/ja043804d},
  abstract = {This study compares the folding of two polypeptides–bovine carbonic anhydrase (BCA) and peracetylated BCA (BCA-Ac(18))–having the same sequence of amino acids but differing by 18 formal units of charge, from a solution containing denaturing concentrations of sodium dodecyl sulfate (SDS). Acetylation of BCA with acetic anhydride converts all 18 lysine-epsilon-NH(3)(+) groups to lysine-epsilon-NHCOCH(3) groups and generates BCA-Ac(18). Both BCA and BCA-Ac(18) are catalytically active, and circular dichroism spectroscopy (CD) suggests that they have similar secondary and tertiary structures. SDS at concentrations above approximately 10 mM denatured both proteins. When the SDS was removed by dialysis, both proteins were regenerated in native form. This study suggests that large differences in the net charge of the polypeptide have no significant influence on the structure, the ability to refold, or the rate of refolding of this protein from solutions containing SDS. This study reinforces the idea that charged residues on the surface of BCA do not guide protein folding and raises the broader question of why proteins have charged residues on their surface, outside of the region of the active site.},
  langid = {english},
  pmid = {15796537},
  file = {/Users/romas/Zotero/storage/4SRB7JP3/Gudiksen et al. - 2005 - Eliminating positively charged lysine epsilon-NH3+.pdf}
}


@article{zhangCloningExpressionCharacterization2009,
  title = {Cloning, Expression and Characterization of an Organic Solvent Tolerant Lipase from \textbackslash{{emphPseudomonas}} Fluorescens {{JCM5963}}},
  author = {Zhang, Aijun and Gao, Renjun and Diao, Naibing and Xie, Guiqiu and Gao, Gui and Cao, Shugui},

@article{mccuneZippedSynthesisCrossmetathesis2016,
  title = {Zipped Synthesis by Cross-Metathesis Provides a Cystathionine \textbackslash s s-Synthase Inhibitor That Attenuates Cellular {{H}}{\textsubscript{2}}{{S}} Levels and Reduces Neuronal Infarction in a Rat Ischemic Stroke Model},

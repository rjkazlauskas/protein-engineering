@article{limNonstereospecificTransaminationCatalyzed1998,
  title = {Nonstereospecific Transamination Catalyzed by Pyridoxal Phosphate-Dependent Amino Acid Racemases of Broad Substrate Specificity.},
  author = {Lim, Young Hee and Yoshimura, Tohru and Kurokawa, Y and Esaki, Nobuyoshi and Soda, Kenji},
  year = 1998,

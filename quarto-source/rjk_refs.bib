@article{leeSequentialDiluteAcid2015,
  title = {Sequential Dilute Acid and Alkali Pretreatment of Corn Stover: Sugar Recovery Efficiency and Structural Characterization.},
  author = {Lee, Jae Won and Kim, Ji Young and Jang, Hyun Min and Lee, Min Woo and Park, Jong Moon},

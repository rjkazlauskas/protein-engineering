  author = {Puk, Oliver and Huber, Petra and Bischoff, Daniel and Recktenwald, Jürgen and Jung, Günther and Süssmuth, Roderich D and {van Pée}, Karl-Heinz and Wohlleben, Wolfgang and Pelzer, Stefan},

  author = {Zhang, Fan and Zeng, Manhao and Yappert, Ryan D. and Sun, Jiakai and Lee, Yu-Hsuan and LaPointe, Anne M. and Peters, Baron and {Abu-Omar}, Mahdi M. and Scott, Susannah L.},

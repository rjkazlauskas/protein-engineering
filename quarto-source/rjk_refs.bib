@article{geibLigninDegradationWoodfeeding2008,
  title = {Lignin Degradation in Wood-Feeding Insects},
  author = {Geib, Scott M and Filley, Timothy R and Hatcher, Patrick G and Hoover, Kelli and Carlson, John E and {Jimenez-Gasco}, Maria del Mar and {Nakagawa-Izumi}, Akiko and Sleighter, Rachel L and Tien, Ming},

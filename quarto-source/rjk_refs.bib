@article{cheung-leeEngineeringHydroxylaseActivity2024,
  title = {Engineering Hydroxylase Activity, Selectivity, and Stability for a Scalable Concise Synthesis of a Key Intermediate to Belzutifan},
  author = {Cheung‐Lee, Wai Ling and Kolev, Joshua N. and McIntosh, John A. and Gil, Agnieszka A. and Pan, Weilan and Xiao, Li and Velásquez, Juan E. and Gangam, Rekha and Winston, Matthew S. and Li, Shasha and Abe, Kotoe and Alwedi, Embarek and Dance, Zachary E. X. and Fan, Haiyang and Hiraga, Kaori and Kim, Jungchul and Kosjek, Birgit and Le, Diane N. and Marzijarani, Nastaran Salehi and Mattern, Keith and McMullen, Jonathan P. and Narsimhan, Karthik and Vikram, Ajit and Wang, Wei and Yan, Jia‐Xuan and Yang, Rong‐Sheng and Zhang, Victoria and Zhong, Wendy and DiRocco, Daniel A. and Morris, William J. and Murphy, Grant S. and Maloney, Kevin M.},
  year = 2024,

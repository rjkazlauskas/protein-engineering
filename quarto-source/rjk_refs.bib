@article{schuitenPromiscuousDehalogenaseActivity2021,
  title = {Promiscuous Dehalogenase Activity of the Epoxide Hydrolase {{CorEH}} from {{{\emph{Corynebacterium}}}} Sp. {{C12}}},
  author = {Schuiten, Eva D. and Badenhorst, Christoffel P. S. and Palm, Gottfried J. and Berndt, Leona and Lammers, Michael and Mican, Jan and Bednar, David and Damborsky, Jiri and Bornscheuer, Uwe T.},

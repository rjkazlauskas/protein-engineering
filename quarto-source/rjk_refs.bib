  title = {Molecular Cloning of the Full-Length {{cDNA}} of ({{S}})-Hydroxynitrile Lyase from {{{\emph{Hevea brasiliensis}}}}. {{Functional}} Expression in {{{\emph{Escherichia coli}}}} and {{{\emph{Saccharomyces cerevisiae}}}} and Identification of an Active Site Residue.},
  author = {Hasslacher, Meinhard and Schwab, Helmut and Schall, Michael and Hayn, Marianne and Griengl, Herfried and Kohlwein, Sepp D},

@article{bottaProbingSubstrateSpecificity1996,
  title = {Probing the Substrate Specificity for Lipases. {{A CoMFA}} Approach for Predicting the Hydrolysis Rates of 2-Arylpropionic Esters Catalyzed by {{Candida}} Rugosa Lipase},
  author = {Botta, Maurizio and Cernia, Enrico and Corelli, Federico and Manetti, Fabrizio and Soro, Simonetta},
  year = 1996,
  journal = {Biochim. Biophys. Acta - Protein Struct. Mol. Enzymol.},
  volume = {1296},
  number = {1},
  pages = {121--126},
  doi = {10.1016/0167-4838(96)00064-7},
  abstract = {The enzyme catalyzed hydrolysis of esters 1-3, precursors of therapeutically important non-steroidal antiinflammatory drugs, in the presence of the lipase from Candida rugosa was studied and the relative rates of the enzymatic hydrolysis were determined. With the exception of 3, which was not transformed under the reaction conditions, all transformations proved to be highly enantiospecific. Usually the mechanism of enantiorecognition is probed by substrate mapping. Although more theoretical approaches are existing, these all require knowledge of the three-dimensional structure of the enzyme. A model capable of correlating the extent of substrate hydrolysis as well as the initial reaction rates with their stereoelectronic properties has been developed by a Comparative Molecular Field Analysis (CoMFA) approach. This model does not require detailed knowledge of the three-dimensional structure of the enzyme and proved to be highly predictive. It is possible that this kind of approach holds promise for future work on enzyme-substrate interactions.},
  langid = {english},
  file = {/Users/romas/Zotero/storage/27LA7FIY/1996-Biochim Biophys Acta Protein Struct Mol Enzymol-121-126.pdf}
}


@article{yamamotoThreedimensionalModelingLigand2000,
  title = {Three-Dimensional Modeling of and Ligand Docking to Vitamin {{D}} Receptor Ligand Binding Domain},
  author = {Yamamoto, Keiko and Masuno, Hiroyuki and Choi, Mihwa and Nakashima, Kinichi and Taga, Tetsuya and Ooizumi, Hiroshi and Umesono, Kazuhiko and Sicinska, Wanda and {van Hooke}, Janeen L and DeLuca, Hector F and Yamada, Sachiko},

@article{mirzaCrystalStructureHomoserine2005,
  title = {Crystal Structure of Homoserine Transacetylase from {{Haemophilus}} Influenzae Reveals a New Family of Alpha/Beta-Hydrolases.},
  author = {Mirza, I Ahmad and Nazi, Ishac and Korczynska, Magdalena and Wright, Gerard D and Berghuis, Albert M},

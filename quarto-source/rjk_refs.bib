@article{galanieCompleteBiosynthesisOpioids2015,
  title = {Complete Biosynthesis of Opioids in Yeast.},
  author = {Galanie, Stephanie and Thodey, Kate and Trenchard, Isis J and Filsinger Interrante, Maria and Smolke, Christina D},
  year = 2015,

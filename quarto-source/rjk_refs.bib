@article{litjensCompetitiveLipasecatalyzedEster1999,
  title = {Competitive Lipase-Catalyzed Ester Hydrolysis and Ammoniolysis in Organic Solvents; Equilibrium Model of a Solid-Liquid-Vapor System.},
  author = {Litjens, M J J and Sha, M and Straathof, A J and Jongejan, Jaap A and Heijnen, J J},
  year = 1999,

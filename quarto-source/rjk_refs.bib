  issn = {0002-7863, 1520-5126},
  doi = {10.1021/ja00487a025},
  urldate = {2024-04-15},
  abstract = {The reactions of cyanohydrin formation and cleavage in dilute aqueous solution have been studied at 25 °C, ionic strength 1.0 M. The compounds studied include 4-NO2-; 3-C1-, 4-C1; 4-C1-; 4-H-; 4-CH3-; 4-CH3O-; and 4-(CH3)2N-substituted benzaldehydes. The equilibrium constants K\textbackslash{} = [{$>$}C(OH)CN]/[HCN][{$>$}C=0] and K\textbackslash{} = [{$>$}C(0\textasciitilde )CN]/[CN\textasciitilde ]· [{$>$}C=0] have been determined from the pH dependence of the apparent cyanohydrin formation constants for this series of compounds and are correlated by p+ values of 1.01 ± 0.04 and 1.49 ± 0.14, respectively. The Kj values (AaT = [{$>$}C(0—)CN]oh+/[{$>$}C(OH)CN]), calculated from Kj = AaHCNA'T/A'i, where XaHCN is the proton dissociation constant for HCN, are correlated by a value of 0.70 ± 0.08. The rates of cyanohydrin formation and breakdown exhibit no significant generalbase-catalyzed contribution, and are accounted for by the rate laws v = k\textbackslash [HCN][{$>$}C=0][OH-] and v = k-i[{$>$}C(OH)CN][OH“] = k\_i'[{$>$}C(0-)CN] where k-¡' = k-\textbackslash Kv//AaT for the forward and reverse reactions, respectively, in the pH range 2.5-7.4. The p+ values for k\textbackslash{} and k-\textbackslash{} are 1.18 ± 0.06 and 0.27 ±0.07, respectively. The p+ value for the carbon-carbon bond cleavage step of the oxyanionic cyanohydrin, k-\textbackslash, is —0.19 ± 0.06. The absence of a detectable pH-independent pathway for cyanohydrin breakdown indicates that complete proton removal to form the oxy anion is necessary for the CN\textasciitilde{} moiety to depart.},
  langid = {english},

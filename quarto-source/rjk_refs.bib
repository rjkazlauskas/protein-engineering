@article{kemmerNonlinearLeastsquaresData2010,
  title = {Nonlinear Least-Squares Data Fitting in {{Excel}} Spreadsheets.},
  author = {Kemmer, Gerdi and Keller, Sandro},
  year = 2010,
  month = feb,
  journal = {Nat. Protoc.},

@article{hogrefeArchaealDUTPaseEnhances2002,
  title = {Archaeal {{dUTPase}} Enhances {{PCR}} Amplifications with Archaeal {{DNA}} Polymerases by Preventing {{dUTP}} Incorporation.},
  author = {Hogrefe, Holly H and Hansen, Connie J and Scott, Bradley R and Nielson, Kirk B},

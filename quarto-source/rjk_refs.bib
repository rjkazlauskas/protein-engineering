@article{plouEnzymaticAcylationDi2002,
  title = {Enzymatic Acylation of Di- and Trisaccharides with Fatty Acids: Choosing the Appropriate Enzyme, Support and Solvent.},
  author = {Plou, Francisco J and Cruces, M Angeles and Ferrer, Manuel and Fuentes, Gloria and Pastor, Eitel and Bernabé, Manuel and Christensen, Morten Würtz and Comelles, Francisco and Parra, José L and Ballesteros, Antonio},

  langid = {english},
  keywords = {Protein function predictions,Protein structure predictions,Proteins},
  file = {/Users/romas/Zotero/storage/ZCHYJZAG/Chen et al. - 2024 - An end-to-end framework for the prediction of protein structure and fitness from single sequence.pdf}
}


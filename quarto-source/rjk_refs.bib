@article{turnerAnalysisConformationalStates2001,
  title = {Analysis of Conformational States of \textbackslash{{emphCandida}} Rugosa Lipase in Solution: Implications for Mechanism of Interfacial Activation and Separation of Open and Closed Forms},
  author = {Turner, Nigel A and Needs, Eric C and Khan, Jeffrey A and Vulfson, Evgeny N},

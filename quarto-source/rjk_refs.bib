@article{stouracCaverWebIdentification2019,
  title = {Caver {{Web}} 1.0: Identification of Tunnels and Channels in Proteins and Analysis of Ligand Transport},
  shorttitle = {Caver {{Web}} 1.0},
  author = {Stourac, Jan and Vavra, Ondrej and Kokkonen, Piia and Filipovic, Jiri and Pinto, Gaspar and Brezovsky, Jan and Damborsky, Jiri and Bednar, David},
  year = 2019,
  month = jul,
  journal = {Nucleic Acids Res.},
  volume = {47},

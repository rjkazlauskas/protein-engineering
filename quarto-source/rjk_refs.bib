  number = {9},
  pages = {4573--4578},
  doi = {10.1073/pnas.080508097},
  abstract = {Mutations in palmitoyl-protein thioesterase 1 (PPT1), a lysosomal enzyme that removes fatty acyl groups from cysteine residues in modified proteins, cause the fatal inherited neurodegenerative disorder infantile neuronal ceroid lipofuscinosis. The accumulation of undigested substrates leads to the formation of neuronal storage bodies that are associated with the clinical symptoms. Less severe forms of PPT1 deficiency have been found recently that are caused by a distinct set of PPT1 mutations, some of which retain a small amount of thioesterase activity. We have determined the crystal structure of PPT1 with and without bound palmitate by using multiwavelength anomalous diffraction phasing. The structure reveals an alpha/beta-hydrolase fold with a catalytic triad composed of Ser115-His289-Asp233 and provides insights into the structural basis for the phenotypes associated with PPT1 mutations.},

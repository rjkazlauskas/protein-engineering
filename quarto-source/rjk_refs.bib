  pmcid = {PMC3771498},
  pmid = {23876529},
  file = {/Users/romas/Zotero/storage/XE2S7P78/Zhou and Lin - 2013 - Photoswitchable fluorescent proteins ten years of.pdf}
}

@article{zhuBiomimeticStudiesMechanism2003,
  title = {Biomimetic Studies on the Mechanism of Stereoselective Lanthionine Formation},
  author = {Zhu, Yantao and Gieselman, Matt D and Zhou, Hao and Averin, Olga and {van der Donk}, Wilfred A},
  year = 2003,

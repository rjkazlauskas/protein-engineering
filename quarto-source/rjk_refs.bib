  journal = {J. Am. Chem. Soc.},
  volume = {126},
  number = {27},
  pages = {8354--8355},
  doi = {10.1021/ja047632w},
  abstract = {Among the numerous well-characterized families of glycosidases, family 4 appears to be the anomaly, requiring both catalytic NAD+ and a divalent metal for activity. The unusual cofactor requirement prompted the proposal of a mechanism involving key NAD+-mediated redox steps as well as elimination of the glycosidic oxygen. Primary kinetic isotope effects for the 2- and 3-deutero substrate analogues, isotopic exchange with solvent, and structural analysis of a 6-phospho-beta-glucosidase, BglT (E.C. 3.2.1.6), provided evidence in support of the proposed mechanism, which has striking resemblances to that of the sugar dehydratases. Furthermore, analysis of the stereochemical outcome indicated that family 4 enzymes are retaining glycosidases.},
  langid = {english},
  pmid = {15237973},
  file = {/Users/romas/Zotero/storage/UQKUTNN9/2004-J Am Chem Soc-8354-8355.pdf}
}


@article{shinInteractionLipoproteinLipaseParaNitrophenyl1992,
  title = {Interaction of {{Lipoprotein-Lipase}} with {{Para-Nitrophenyl N-Alkylcarbamates}} - {{Kinetics}}, {{Mechanism}}, and {{Analogy}} to the {{Acylenzyme Mechanism}}},
  author = {Shin, Hyeon-Cheol and Quinn, Daniel M},
  year = 1992,
  journal = {Biochemistry},

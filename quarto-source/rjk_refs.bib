@article{dodgeRecombinantPseudomonasGrowing2023,
  title = {Recombinant {{{\emph{Pseudomonas}}}} Growing on Non-Natural Fluorinated Substrates Shows Stress but Overall Tolerance to Cytoplasmically Released Fluoride Anion},
  author = {Dodge, Anthony G. and Thoma, Calvin J. and O’Connor, Madeline R. and Wackett, Lawrence P.},

@article{leePhotondirectedMultiplexedEnzymatic2020,
  title = {Photon-Directed Multiplexed Enzymatic {{DNA}} Synthesis for Molecular Digital Data Storage},
  author = {Lee, Howon and Wiegand, Daniel J. and Griswold, Kettner and Punthambaker, Sukanya and Chun, Honggu and Kohman, Richie E. and Church, George M.},

@article{parraviciniEvaluationConformationalStability2016,
  title = {Evaluation of the Conformational Stability of Recombinant Desulfurizing Enzymes from a Newly Isolated {{Rhodococcus}} Sp.},
  author = {Parravicini, Federica and Brocca, Stefania and Lotti, Marina},

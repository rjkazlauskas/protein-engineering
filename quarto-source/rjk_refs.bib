@article{rohrigAttractingCavities202023,
  title = {Attracting {{Cavities}} 2.0: Improving the Flexibility and Robustness for Small-Molecule Docking},
  shorttitle = {Attracting Cavities 2.0},
  author = {Röhrig, Ute F. and Goullieux, Mathilde and Bugnon, Marine and Zoete, Vincent},
  year = 2023,

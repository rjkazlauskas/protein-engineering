@article{guoProcedureRemovalCyanuric2022,
  title = {A Procedure for Removal of Cyanuric Acid in Swimming Pools Using a Cell-Free Thermostable Cyanuric Acid Hydrolase},
  author = {Guo, Feng and McAuliffe, Joseph C and Bongiorni, Cristina and Latone, Jacob A and Pepsin, Mike J and Chow, Marina S and Dhaliwal, Raj S and Hoffmann, Katherine M and Brazil, Bill T and Heng, Meng H and Robinson, Serina L and Wackett, Lawrence P and Whited, Gregory M},

@article{deraadtConceptDockingProtecting2001,
  title = {The Concept of Docking and Protecting Groups in Biohydroxylation},
  author = {{de Raadt}, Anna and Griengl, Herfried and Weber, Hansjörg},
  year = 2001,
  journal = {Chem. - Eur. J.},

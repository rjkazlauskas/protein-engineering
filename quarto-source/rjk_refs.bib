@article{torokDesaturationOxygenation12dihydronaphthalene1995,
  title = {Desaturation and Oxygenation of 1,2-Dihydronaphthalene by Toluene and Naphthalene Dioxygenase.},
  author = {Torok, Daniel S and Resnick, Sol M and Brand, John M and Cruden, Diana L and Gibson, David T},
  year = 1995,

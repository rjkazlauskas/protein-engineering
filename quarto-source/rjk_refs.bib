@article{huffmanDesignVitroBiocatalytic2019,
  title = {Design of an in Vitro Biocatalytic Cascade for the Manufacture of Islatravir},
  author = {Huffman, Mark A. and Fryszkowska, Anna and Alvizo, Oscar and {Borra-Garske}, Margie and Campos, Kevin R. and Canada, Keith A. and Devine, Paul N. and Duan, Da and Forstater, Jacob H. and Grosser, Shane T. and Halsey, Holst M. and Hughes, Gregory J. and Jo, Junyong and Joyce, Leo A. and Kolev, Joshua N. and Liang, Jack and Maloney, Kevin M. and Mann, Benjamin F. and Marshall, Nicholas M. and McLaughlin, Mark and Moore, Jeffrey C. and Murphy, Grant S. and Nawrat, Christopher C. and Nazor, Jovana and Novick, Scott and Patel, Niki R. and {Rodriguez-Granillo}, Agustina and Robaire, Sandra A. and Sherer, Edward C. and Truppo, Matthew D. and Whittaker, Aaron M. and Verma, Deeptak and Xiao, Li and Xu, Yingju and Yang, Hao},
  year = 2019,
  month = dec,
  journal = {Science},
  volume = {366},
  number = {6470},
  pages = {1255--1259},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.aay8484},
  urldate = {2022-05-04},
  abstract = {Maximal efficiency from enzyme cascades                            Enzymes are highly selective catalysts that can be useful for specific transformations in organic synthesis. Huffman               et al.               combined designer enzymes in a multistep cascade reaction (see the Perspective by O'Reilly and Ryan). The approach eliminates purification steps, recycles expensive cofactors, and couples favorable and unfavorable reactions. With the target molecule islatravir, an experimental HIV drug, they optimized five enzymes by directed evolution to be compatible with unnatural substrates and stable in the reaction conditions. Stereochemical purity was amplified at every enzymatic step, and the final synthesis was both atom economical and efficient.                                         Science               , this issue p.               1255               ; see also p.               1199                        ,              A multistep biocatalytic cascade is applied to the synthesis of the experimental HIV drug islatravir.           ,              Enzyme-catalyzed reactions have begun to transform pharmaceutical manufacturing, offering levels of selectivity and tunability that can dramatically improve chemical synthesis. Combining enzymatic reactions into multistep biocatalytic cascades brings additional benefits. Cascades avoid the waste generated by purification of intermediates. They also allow reactions to be linked together to overcome an unfavorable equilibrium or avoid the accumulation of unstable or inhibitory intermediates. We report an in vitro biocatalytic cascade synthesis of the investigational HIV treatment islatravir. Five enzymes were engineered through directed evolution to act on non-natural substrates. These were combined with four auxiliary enzymes to construct islatravir from simple building blocks in a three-step biocatalytic cascade. The overall synthesis requires fewer than half the number of steps of the previously reported routes.},
  langid = {english},
  file = {/Users/romas/Zotero/storage/9TCMHXS5/Huffman et al. - 2019 - Design of an in vitro biocatalytic cascade for the.pdf;/Users/romas/Zotero/storage/E6MP33LK/2019-S-1255 errata.pdf;/Users/romas/Zotero/storage/MNGUWRD7/2019-S-1255 comment.pdf}
}


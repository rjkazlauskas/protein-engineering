@article{carrasco-lopezActivationBacterialThermoalkalophilic2009,
  title = {Activation of Bacterial Thermoalkalophilic Lipases Is Spurred by Dramatic Structural Rearrangements.},
  author = {{Carrasco-López}, César and Godoy, César and {de Las Rivas}, Blanca and {Fernández-Lorente}, Gloria and Palomo, José M and Guisan, José M and {Fernandez-Lafuente}, Roberto and {Martínez-Ripoll}, Martín and Hermoso, Juan A},
  year = 2009,
  month = feb,
  journal = {J. Biol. Chem.},
  volume = {284},
  number = {7},
  pages = {4365--4372},
  doi = {10.1074/jbc.M808268200},
  abstract = {The bacterial thermoalkalophilic lipases that hydrolyze saturated fatty acids at 60-75 degrees C and pH 8-10 are grouped as the lipase family I.5. We report here the crystal structure of the lipase from Geobacillus thermocatenulatus, the first structure of a member of the lipase family I.5 showing an open configuration. Unexpectedly, enzyme activation involves large structural rearrangements of around 70 amino acids and the concerted movement of two lids, the alpha6- and alpha7-helices, unmasking the active site. Central in the restructuring process of the lids are both the transfer of bulky hydrophobic residues out of the N-terminal end of the alpha6-helix and the incorporation of short side chain residues to the alpha6 C-terminal end. All these structural changes are stabilized by the Zn(2+)-binding domain, which is characteristic of this family of lipases. Two detergent molecules are placed in the active site, mimicking chains of the triglyceride substrate, demonstrating the position of the oxyanion hole and the three pockets that accommodate the sn-1, sn-2, and sn-3 fatty acids chains. The combination of structural and biochemical studies indicate that the lid opening is not mediated by temperature but triggered by interaction with lipid substrate.},
  langid = {english},
  pmid = {19056729},
  file = {/Users/romas/Zotero/storage/5MEG5L5T/Carrasco-López et al. - 2009 - Activation of bacterial thermoalkalophilic lipases.pdf}
}


@article{gobeilMaintenanceNativelikeProtein2014,
  title = {Maintenance of Native-like Protein Dynamics May Not Be Required for Engineering Functional Proteins.},
  author = {Gobeil, Sophie M C and Clouthier, Christopher M and Park, Jaeok and Gagné, Donald and Berghuis, Albert M and Doucet, Nicolas and Pelletier, Joelle N},
  year = 2014,
  month = oct,
  journal = {Chem. Biol.},
  volume = {21},
  number = {10},
  pages = {1330--1340},
  doi = {10.1016/j.chembiol.2014.07.016},
  abstract = {Proteins are dynamic systems, and understanding dynamics is critical for fully understanding protein function. Therefore, the question of whether laboratory engineering has an impact on protein dynamics is of general interest. Here, we demonstrate that two homologous, naturally evolved enzymes with high degrees of structural and functional conservation also exhibit conserved dynamics. Their similar set of slow timescale dynamics is highly restricted, consistent with evolutionary conservation of a functionally important feature. However, we also show that dynamics of a laboratory-engineered chimeric enzyme obtained by recombination of the two homologs exhibits striking difference on the millisecond timescale, despite function and high-resolution crystal structure (1.05 \textbackslash AA) being conserved. The laboratory-engineered chimera is thus functionally tolerant to modified dynamics on the timescale of catalytic turnover. Tolerance to dynamic variation implies that maintenance of native-like protein dynamics may not be required when engineering functional proteins.},
  langid = {english},
  pmid = {25200606},
  file = {/Users/romas/Zotero/storage/TFZMFE7X/F40230D1-CAB6-467A-A5DA-5B1F342F1679.pdf}
}

@article{goberMutatingHighlyConserved2016,
  title = {Mutating a Highly Conserved Residue in Diverse Cytochrome {{P450s}} Facilitates Diastereoselective Olefin Cyclopropanation},
  author = {Gober, Joshua G and Rydeen, Amy E and {Gibson-O'Grady}, Evan J and Leuthaeuser, Janelle B and Fetrow, Jacquelyn S and Brustad, Eric M},
  year = 2016,
  month = mar,
  journal = {ChemBioChem},
  volume = {17},
  number = {5},
  pages = {394--397},
  doi = {10.1002/cbic.201500624},
  abstract = {Cytochrome P450s and other heme-containing proteins have recently been shown to have promiscuous activity for the cyclopropanation of olefins using diazoacetate reagents. Despite the progress made thus far, engineering selective catalysts for all possible stereoisomers for the cyclopropanation reaction remains a considerable challenge. Previous investigations of a model P450 (P450BM3 ) revealed that mutation of a conserved active site threonine (Thr268) to alanine transformed the enzyme into a highly active and selective cyclopropanation catalyst. By incorporating this mutation into a diverse panel of P450 scaffolds, we were able to quickly identify enantioselective catalysts for all possible diastereomers in the model reaction of styrene with ethyl diazoacetate. Some alanine variants exhibited selectivities that were markedly different from the wild-type enzyme, with a few possessing moderate to high diastereoselectivity and enantioselectivities up to 97 \% for synthetically challenging cis-cyclopropane diastereomers.},
  langid = {english},
  pmcid = {PMC5241096},
  pmid = {26690878},
  file = {/Users/romas/Zotero/storage/DS49C9TM/Gober et al. - 2016 - Mutating a highly conserved residue in diverse cyt.pdf}
}


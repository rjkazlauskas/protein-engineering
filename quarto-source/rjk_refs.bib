@article{broccaDesignTotalSynthesis1998,
  title = {Design, Total Synthesis, and Functional Overexpression of the {{Candida}} Rugosa Lip1 Gene Coding for a Major Industrial Lipase},
  author = {Brocca, Stefania and {Schmidt-Dannert}, Claudia and Lotti, Marina and Alberghina, Lilia and Schmid, Rolf D},

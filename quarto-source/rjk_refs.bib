@article{haringSemisyntheticEnzymesAsymmetric1999,
  title = {Semisynthetic {{Enzymes}} in {{Asymmetric Synthesis}}: {{Enantioselective Reduction}} of {{Racemic Hydroperoxides Catalyzed}} by {{Seleno-Subtilisin}}.},
  author = {Haring, Dietmar and Schüler, Ellen and Adam, Waldemar and {Saha-Moller}, Chantu R and Schreiner, Peter R},

@article{hasmannHydroxylationPolypropyleneUsing2012,
  title = {Hydroxylation of Polypropylene Using the Monooxygenase Mutant 139-3 from {{{\emph{Bacillus}}}}{\emph{ Megaterium }}{{{\emph{BM3}}}}},

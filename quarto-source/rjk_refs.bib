@article{bauerKineticStudiesEnzyme1999,
  title = {Kinetic Studies on the Enzyme ({{S}})-Hydroxynitrile Lyase from {{Hevea}} Brasiliensis Using Initial Rate Methods and Progress Curve Analysis},
  author = {Bauer, Michael and Griengl, Herfried and Steiner, Walter},
  year = 1999,

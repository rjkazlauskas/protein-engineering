@article{kongDirectReversibleDecarboxylation2020,
  title = {Direct Reversible Decarboxylation from Stable Organic Acids in Dimethylformamide Solution},
  author = {Kong, Duanyang and Moon, Patrick J. and Lui, Erica K. J. and Bsharat, Odey and Lundgren, Rylan J.},
  year = 2020,
  month = jul,
  journal = {Science},
  volume = {369},
  number = {6503},

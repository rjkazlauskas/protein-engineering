  author = {Marek, Jaromír and Vévodová, Jitka and Smatanová, Ivana Kutá and Nagata, Yuji and Svensson, L Anders and Newman, Janet and Takagi, Masamichi and Damborsky, Jirí},
  year = 2000,
  month = nov,
  journal = {Biochemistry},

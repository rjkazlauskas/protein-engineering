@article{hsiehStructurebasedDesignPrefusionstabilized2020,
  title = {Structure-Based Design of Prefusion-Stabilized {{SARS-CoV-2}} Spikes},
  author = {Hsieh, Ching-Lin and Goldsmith, Jory A. and Schaub, Jeffrey M. and DiVenere, Andrea M. and Kuo, Hung-Che and Javanmardi, Kamyab and Le, Kevin C. and Wrapp, Daniel and Lee, Alison G. and Liu, Yutong and Chou, Chia-Wei and Byrne, Patrick O. and Hjorth, Christy K. and Johnson, Nicole V. and {Ludes-Meyers}, John and Nguyen, Annalee W. and Park, Juyeon and Wang, Nianshuang and Amengor, Dzifa and Lavinder, Jason J. and Ippolito, Gregory C. and Maynard, Jennifer A. and Finkelstein, Ilya J. and McLellan, Jason S.},

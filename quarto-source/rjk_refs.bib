}

@article{sobolevEffectAcylChain2002,
  title = {Effect of Acyl Chain Length and Branching on the Enantioselectivity of {{Candida}} Rugosa Lipase in the Kinetic Resolution of 4-(2-Difluoromethoxyphenyl)-Substituted 1,4-Dihydropyridine 3,5-Diesters},
  author = {Sobolev, Arkadij and Franssen, Maurice C R and Vigante, Brigita and Cekavicus, Brigita and Zhalubovskis, Raivis and Kooijman, Huub and Spek, Anthony L and Duburs, Gunars and {de Groot}, Aede},

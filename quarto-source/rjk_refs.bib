@article{killeReducingCodonRedundancy2013,
  title = {Reducing Codon Redundancy and Screening Effort of Combinatorial Protein Libraries Created by Saturation Mutagenesis},
  author = {Kille, Sabrina and {Acevedo-Rocha}, Carlos G. and Parra, Loreto P. and Zhang, Zhi-Gang and Opperman, Diederik J. and Reetz, Manfred T. and Acevedo, Juan Pablo},

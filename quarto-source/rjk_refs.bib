@article{puthanveetilAspartaseFumaraseSuperfamily2012,
  title = {Aspartase/Fumarase Superfamily: A Common Catalytic Strategy Involving General Base-Catalyzed Formation of a Highly Stabilized Aci-Carboxylate Intermediate},
  shorttitle = {Aspartase/Fumarase Superfamily},
  author = {Puthan Veetil, Vinod and Fibriansah, Guntur and Raj, Hans and Thunnissen, Andy-Mark W. H. and Poelarends, Gerrit J.},

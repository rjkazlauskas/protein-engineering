  author = {Druzhinina, Irina S and {Seidl-Seiboth}, Verena and Horwitz, Benjamin A and Kenerley, Charles M and Monte, Enrique and Mukherjee, Prasun K and Zeilinger, Susanne and Grigoriev, Igor V and Kubicek, C P},
  year = 2011,
  month = oct,
  journal = {Nat. Rev. Microbiol.},

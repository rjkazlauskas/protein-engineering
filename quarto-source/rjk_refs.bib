@incollection{jonesConsensusFinderWeb2020,
  title = {Consensus {{Finder}} Web Tool to Predict Stabilizing Substitutions in Proteins},
  booktitle = {Enzyme {{Engineering}} and {{Evolution}}: {{General Methods}}},

  author = {Qu, Shen and Kolodziej, Edward P and Long, Sarah A and Gloer, James B and Patterson, Eric V and Baltrusaitis, Jonas and Jones, Gerrad D and Benchetler, Peter V and Cole, Emily A and Kimbrough, Kaitlin C and Tarnoff, Matthew D and Cwiertny, David M},

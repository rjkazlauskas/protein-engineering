@article{dimitriouAlphaBetahydrolasesUnique2017,
  title = {Alpha/Beta-Hydrolases: {{A}} Unique Structural Motif Coordinates Catalytic Acid Residue in 40 Protein Fold Families},
  author = {Dimitriou, Polytimi S. and Denesyuk, Alexander and Takahashi, Seiji and Yamashita, Satoshi and Johnson, Mark S. and Nakayama, Toru and Denessiouk, Konstantin},
  year = 2017,

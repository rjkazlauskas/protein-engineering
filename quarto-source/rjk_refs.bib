  author = {Benoit, Isabelle and Asther, Michele and Sulzenbacher, Gerlind and Record, Eric and Marmuse, Laurence and Parsiegla, Goetz and Gimbert, Isabelle and Asther, Marcel and Bignon, Christophe},

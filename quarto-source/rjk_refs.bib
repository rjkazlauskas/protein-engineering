  author = {Mansfeld, Johanna and Vriend, Gert and Dijkstra, Bauke W and Veltman, Oene R and {van den Burg}, Bertus and Venema, Gerard and {Ulbrich-Hofmann}, R and Eijsink, Vincent G H},

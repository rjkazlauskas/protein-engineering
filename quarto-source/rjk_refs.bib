  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.abc5441},
  urldate = {2021-03-22},
  abstract = {The current scale of plastics production and the accompanying waste disposal problems represent a largely untapped opportunity for chemical upcycling. Tandem catalytic conversion by platinum supported on γ-alumina converts various polyethylene grades in high yields (up to 80 weight percent) to low-molecular-weight liquid/wax products, in the absence of added solvent or molecular hydrogen, with little production of light gases. The major components are valuable long-chain alkylaromatics and alkylnaphthenes (average \textasciitilde C               30               , dispersity Ð = 1.1). Coupling exothermic hydrogenolysis with endothermic aromatization renders the overall transformation thermodynamically accessible despite the moderate reaction temperature of 280°C. This approach demonstrates how waste polyolefins can be a viable feedstock for the generation of molecular hydrocarbon products.},
  langid = {english},
  file = {/Users/romas/Zotero/storage/EF3ST3WB/Zhang et al. - 2020 - Polyethylene upcycling to long-chain alkylaromatic.pdf;/Users/romas/Zotero/storage/UU3ELFFC/2020-S-437 N&V.pdf}

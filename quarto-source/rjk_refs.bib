  author = {Lampel, Ayala and McPhee, Scott A and Park, Hang-Ah and Scott, Gary G and Humagain, Sunita and Hekstra, Doeke R and Yoo, Barney and Frederix, Pim W J M and Li, Tai-De and Abzalimov, Rinat R and Greenbaum, Steven G and Tuttle, Tell and Hu, Chunhua and Bettinger, Christopher J and Ulijn, Rein V},
  year = 2017,

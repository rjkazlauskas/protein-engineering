@article{tabtiangConsolidatingCriticalBinding2005,
  title = {Consolidating Critical Binding Determinants by Noncyclic Rearrangement of Protein Secondary Structure.},
  author = {Tabtiang, Ramon K and Cezairliyan, Brent O and Grant, Robert A and Cochrane, Jesse C and Sauer, Robert T},

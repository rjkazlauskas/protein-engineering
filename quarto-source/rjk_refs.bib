@article{guangIdentificationThermostableLevansucrase2023,
  title = {Identification of a Thermostable Levansucrase from {{{\emph{Pseudomonas orientalis}}}} That Allows Unique Product Specificity at Different Temperatures},
  author = {Guang, Cuie and Zhang, Xiaoqi and Ni, Dawei and Zhang, Wenli and Xu, Wei and Mu, Wanmeng},
  year = 2023,
  month = mar,
  journal = {Polymers},
  volume = {15},
  number = {6},
  pages = {1435},
  issn = {2073-4360},
  doi = {10.3390/polym15061435},
  urldate = {2024-02-26},
  abstract = {The biological production of levan by levansucrase (LS, EC 2.4.1.10) has aroused great interest in the past few years. Previously, we identified a thermostable levansucrase from Celerinatantimonas diazotrophica (Cedi-LS). A novel thermostable LS from Pseudomonas orientalis (Psor-LS) was successfully screened using the Cedi-LS template. The Psor-LS showed maximum activity at 65 ◦C, much higher than the other LSs. However, these two thermostable LSs showed significantly different product specificity. When the temperature was decreased from 65 to 35 ◦C, Cedi-LS tended to produce high-molecular-weight (HMW) levan. By contrast, Psor-LS prefers to generate fructooligosaccharides (FOSs, DP ≤ 16) rather than HMW levan under the same conditions. Notably, at 65 ◦C, Psor-LS would produce HMW levan with an average Mw of 1.4 × 106 Da, indicating that a high temperature might favor the accumulation of HMW levan. In summary, this study allows a thermostable LS suitable for HMW levan and levan-type FOSs production simultaneously.},
  langid = {english},
  file = {/Users/romas/Zotero/storage/7LUILWF5/Guang et al. - 2023 - Identification of a thermostable levansucrase from Pseudomonas orientaliss.pdf}
}


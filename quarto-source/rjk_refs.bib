@article{uchiyamaLyticPolysaccharideMonooxygenase2022,
  title = {Lytic Polysaccharide Monooxygenase Increases Cellobiohydrolases Activity by Promoting Decrystallization of Cellulose Surface},
  author = {Uchiyama, Taku and Uchihashi, Takayuki and Ishida, Takuya and Nakamura, Akihiko and Vermaas, Josh V. and Crowley, Michael F. and Samejima, Masahiro and Beckham, Gregg T. and Igarashi, Kiyohiko},

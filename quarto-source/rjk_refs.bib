@article{ruiProteinEngineeringEpoxide2005,
  title = {Protein Engineering of Epoxide Hydrolase from {{Agrobacterium}} Radiobacter {{AD1}} for Enhanced Activity and Enantioselective Production of ({{R}})-1-Phenylethane-1,2-Diol.},
  author = {Rui, Lingyun and Cao, Li and Chen, Wilfred and Reardon, Kenneth F and Wood, Thomas K},
  year = 2005,
  month = jul,
  journal = {Appl. Environ. Microbiol.},
  volume = {71},

@article{zimmermannModellingReactionCourse2007,
  title = {Modelling the Reaction Course of {{N-acetylneuraminic}} Acid Synthesis from {{N-acetyl-D-glucosamine}}–New Strategies for the Optimisation of Neuraminic Acid Synthesis.},
  author = {Zimmermann, Vera and Hennemann, Hans-Georg and {Dau\textbackslash s smann}, Thomas and Kragl, Udo},
  year = 2007,

  author = {Alcaide, María and Tornés, Jesús and Stogios, Peter J and Xu, Xiaohui and Gertler, Christoph and Di Leo, Rosa and Bargiela, Rafael and Lafraya, Álvaro and Guazzaroni, María-Eugenia and López Cortés, Nieves and Chernikova, Tatyana N and Golyshina, Olga V and Nechitaylo, Taras Y and Plumeier, Iris and Pieper, Dietmar H and Yakimov, Michail M and Savchenko, Alexei and Golyshin, Peter N and Ferrer, Manuel},
